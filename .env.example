EXECUTOR_SERVICE_NAME=executor-service
EXECUTOR_LOG_LEVEL=INFO

EXECUTOR_REDIS_URL=redis://redis:6379/0
EXECUTOR_REDIS_STREAM_NAME=execution:commands
EXECUTOR_REDIS_GROUP_NAME=execution-workers
EXECUTOR_REDIS_EXECUTION_KEY_PREFIX=execution
EXECUTOR_REDIS_BLOCK_MS=5000
EXECUTOR_REDIS_BATCH_SIZE=1
EXECUTOR_REDIS_CONNECT_TIMEOUT_SECONDS=5
EXECUTOR_REDIS_PENDING_IDLE_MS=60000
EXECUTOR_REDIS_CLAIM_INTERVAL_SECONDS=30

EXECUTOR_CONSUMER_NAME_PREFIX=executor
EXECUTOR_MAX_CONCURRENCY=2
EXECUTOR_SHUTDOWN_TIMEOUT_SECONDS=30

EXECUTOR_JUPYTER_BASE_URL=http://jupyter:8888
EXECUTOR_JUPYTER_TOKEN=
EXECUTOR_JUPYTER_REQUEST_TIMEOUT_SECONDS=30
EXECUTOR_JUPYTER_WEBSOCKET_OPEN_TIMEOUT_SECONDS=30
EXECUTOR_JUPYTER_WEBSOCKET_PING_INTERVAL_SECONDS=20
EXECUTOR_JUPYTER_WEBSOCKET_PING_TIMEOUT_SECONDS=20
EXECUTOR_JUPYTER_WEBSOCKET_PROTOCOL=
EXECUTOR_ANALYSIS_KERNEL_NAME=analysis-env
EXECUTOR_MODELING_KERNEL_NAME=modeling-env

EXECUTOR_CALLBACK_TIMEOUT_SECONDS=5
EXECUTOR_CALLBACK_MAX_ATTEMPTS=3
EXECUTOR_CALLBACK_BACKOFF_SECONDS=1

